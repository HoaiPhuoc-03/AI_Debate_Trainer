# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=90

# Speech mode
SPEECH_MAX_AUDIO_BYTES=8388608
SPEECH_TTS_MAX_CHARS=1200
GROQ_STT_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_TIMEOUT_SECONDS=60

# Edge TTS (Microsoft Edge Text-to-Speech - no API key required)
# Voices: vi-VN-NamMinhNeural (male), vi-VN-HoaiMyNeural (female)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+10%

# Firebase API
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n..."}
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
