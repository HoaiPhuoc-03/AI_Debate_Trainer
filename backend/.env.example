# =========================================================
# AI Debate Trainer - Environment Example
# =========================================================

# ---------------------------------------------------------
# Groq LLM
# Used for AI rebuttal, scoring, feedback, and response generation
# ---------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=90


# ---------------------------------------------------------
# Speech-to-Text: ElevenLabs
# Used to convert user voice input into text
# ---------------------------------------------------------
VOICE_STT_PROVIDER=elevenlabs
VOICE_STT_FALLBACK=
SPEECH_MAX_AUDIO_BYTES=8388608

ELEVENLABS_API_KEY=
ELEVENLABS_STT_BASE_URL=https://api.elevenlabs.io/v1/speech-to-text
ELEVENLABS_STT_MODEL=scribe_v2


# ---------------------------------------------------------
# Text-to-Speech: Microsoft Edge TTS
# Used to read AI feedback/rebuttal aloud
# No API key required
# Available Vietnamese voices:
# - vi-VN-NamMinhNeural
# - vi-VN-HoaiMyNeural
# ---------------------------------------------------------
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+10%
SPEECH_TTS_MAX_CHARS=1200


# ---------------------------------------------------------
# Storage and Authentication
# ---------------------------------------------------------
STORAGE_PROVIDER=supabase
AUTH_PROVIDER=supabase


# ---------------------------------------------------------
# Supabase
# Used for Auth, user profiles, debate sessions, scores,
# feedback, fact-checking data, and progress dashboard
# ---------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only fill this if the backend uses direct PostgreSQL access
# through SQLAlchemy/psycopg. Leave blank if using Supabase client only.
DATABASE_URL=
